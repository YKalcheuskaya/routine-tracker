{
  "name": "routine-tracker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test e2e/routine-tracker.spec.js",
    "test:local-auth": "playwright test e2e/local-auth.spec.js",
    "test:browser": "playwright test",
    "verify:core": "npm run lint && npm test && npm run build && npm run test:e2e && npm audit",
    "verify:full": "npm run lint && npm test && npm run build && npm audit && npm run test:browser",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:env": "node scripts/write-local-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "vitest": "^5.0.0"
  }
}
